{
  "uid": "hexacore",
  "title": "HEXACORE · Instancias y logs",
  "tags": [
    "hexacore"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes, servicio)",
          "refId": "servicio"
        },
        "definition": "label_values(container_memory_working_set_bytes, servicio)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Instancias vivas (gateway y programas)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (servicio) (container_memory_working_set_bytes{servicio=~\"api-gateway|nucleo|boleteria|trabajador\", name!=\"\"})",
          "legendFormat": "{{servicio}}",
          "refId": "A"
        }
      ],
      "description": "Cuántos contenedores de cada servicio reporta Docker ahora mismo. Al tumbar una réplica baja y vuelve a subir cuando Docker la reinicia.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "CPU por instancia",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{servicio=~\"$servicio\", name!=\"\"}[30s])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "Porcentaje de un núcleo que usa cada contenedor (API de Docker).",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Memoria por instancia",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (container_memory_working_set_bytes{servicio=~\"$servicio\", name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "Memoria de trabajo de cada contenedor (API de Docker).",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Peticiones por réplica (gateway)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (upstream) (count_over_time({servicio=\"api-gateway\"} != \"/grafana/\" |~ \"upstream=[0-9]\" | regexp \"upstream=(?P<upstream>[^ ,]+)\" [10s]))",
          "legendFormat": "{{upstream}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "description": "A qué réplica mandó el gateway cada petición, leído de su log (upstream=). Muestra el reparto y cómo se reparte entre las que quedan cuando una cae.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Respuestas del gateway por código",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (estado) (count_over_time({servicio=\"api-gateway\"} != \"/grafana/\" |~ \"upstream=\" | regexp \"\\\" (?P<estado>[0-9]{3}) \" [10s]))",
          "legendFormat": "{{estado}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Latencia p95 del gateway",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 13,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {servicio=\"api-gateway\"} != \"/grafana/\" |~ \"upstream=[0-9]\" | regexp \"rt=(?P<rt>[0-9.]+)\" | unwrap rt [30s]) by (servicio)",
          "legendFormat": "p95",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{servicio=~\"$servicio\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}