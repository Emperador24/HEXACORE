# Copiar a .env (que está en .gitignore) antes de levantar el servicio:
#   cp .env.example .env
#
# Los valores por defecto apuntan a la infraestructura local de
# App/infra/docker-compose.yml, así que con copiar el archivo tal cual basta.

NODE_ENV=development
PUERTO=3001
PREFIJO_API=api/v1

# --- PostgreSQL (ADR-06) — base propia de este microservicio (ADR-01) ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=entradas_mercado_secundario

# --- Redis (ADR-03) — bloqueo distribuido del checkout ---
# 6380, no 6379: el docker-compose lo expone ahí para no chocar con un Redis
# instalado localmente (Homebrew suele dejar uno escuchando en 6379).
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- RabbitMQ (ADR-10) — evento ENTRADA_TRANSFERIDA ---
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Pasarela de pagos (actor externo del CU-006) ---
# En desarrollo apunta al simulador de App/infra/pasarela-pagos-simulada.
# Sustituir el proveedor debe tocar solo el adaptador, nunca el dominio (RNF-16).
PASARELA_URL=http://localhost:3099
PASARELA_TIMEOUT_MS=10000

# --- Reglas de negocio de la reventa ---
# Los cuatro valores siguientes NO están fijados en la documentación del
# proyecto. El razonamiento de cada uno está en DECISIONES.md.

# Tope del precio de reventa, como múltiplo del precio original de la entrada.
REVENTA_TOPE_PRECIO_FACTOR=1.5

# Porcentaje que retiene la plataforma al liquidar al vendedor (paso 13 del CU-006).
REVENTA_COMISION_PORCENTAJE=10

# Vida del bloqueo de Redis durante el checkout. Debe superar PASARELA_TIMEOUT_MS.
REVENTA_BLOQUEO_TTL_SEGUNDOS=120

# Minutos antes del inicio del evento en que se cierra la reventa (CU-006D).
# 0 = se puede revender hasta el momento en que el evento empieza.
REVENTA_MARGEN_CIERRE_MINUTOS=0

# Cada cuánto se barren las publicaciones vencidas (CU-006D), en formato cron.
# Por defecto cada 10 minutos. Acortarlo sirve para ver el trabajo funcionar sin
# esperar; la expiración no es urgente porque el listado del mercado ya filtra
# por fecha desde el instante en que una publicación vence.
# EXPIRACION_CRON=*/10 * * * * *

# --- Autenticación (RNF-06) ---
# Clave PÚBLICA con la que se verifican los tokens que emite el Servicio de
# Administración. Vacía = la de desarrollo (App/infra/claves-desarrollo); en
# producción es obligatoria y no puede ser esa.
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
