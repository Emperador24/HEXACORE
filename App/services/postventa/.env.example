# Copiar a .env antes de levantar:  cp .env.example .env

NODE_ENV=development
PUERTO=3011
PREFIJO_API=api/v1

# --- PostgreSQL — base propia: publicaciones y transacciones de reventa ---
# NO está la tabla de entradas: es de Ventas desde ADR-14. La publicación la
# referencia por `entrada_id` y lleva una copia de lo que anuncia.
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=postventa

# --- Redis — bloqueo del checkout (ADR-03) y sesiones revocadas (ADR-11) ---
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- RabbitMQ — notificaciones y liquidaciones (ADR-04) ---
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Pagos (ADR-14) — este servicio no conoce la pasarela, solo a Pagos ---
PAGOS_URL=http://localhost:3008/api/v1
PAGOS_TIMEOUT_MS=12000

# --- Ventas — el dueño de `Entrada`. Aquí se le pide retener y transferir ---
# Más largo que el de Acceso QR: allí hay alguien delante de un lector, aquí el
# comprador ya está en una pantalla de "procesando", y cortar pronto una
# transferencia con el pago hecho sería peor que esperar.
VENTAS_URL=http://localhost:3001/api/v1
VENTAS_TIMEOUT_MS=8000

# --- Reglas de la reventa (DECISIONES.md) ---
# El TTL del bloqueo debe superar PAGOS_TIMEOUT_MS + VENTAS_TIMEOUT_MS: cubre
# las DOS llamadas remotas del checkout, o caducaría con una en vuelo.
REVENTA_TOPE_PRECIO_FACTOR=1.5
REVENTA_COMISION_PORCENTAJE=10
REVENTA_BLOQUEO_TTL_SEGUNDOS=120
REVENTA_MARGEN_CIERRE_MINUTOS=0

# --- Autenticación (RNF-06) ---
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
