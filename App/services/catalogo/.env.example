# Copiar a .env (que está en .gitignore) antes de levantar el servicio:
#   cp .env.example .env
#
# Los valores por defecto apuntan a la infraestructura local de
# App/infra/docker-compose.yml, así que con copiar el archivo tal cual basta.

NODE_ENV=development
PUERTO=3004
PREFIJO_API=api/v1

# --- PostgreSQL (ADR-06) — base propia de este microservicio (ADR-14) ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=catalogo

# Eso es todo. La cartelera es pública (no verifica tokens), y no usa Redis,
# ni el broker, ni la pasarela de pagos: por eso este archivo cabe en una
# pantalla y el de entradas-mercado-secundario no.
