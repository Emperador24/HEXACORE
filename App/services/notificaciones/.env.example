# Copiar a .env (que está en .gitignore) antes de levantar el servicio:
#   cp .env.example .env

NODE_ENV=development
PUERTO=3006
PREFIJO_API=api/v1

# --- Broker (ADR-10) — de aquí salen los correos por enviar ---
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Proveedor de correo (actor externo) ---
# En desarrollo apunta al simulador de App/infra/correo-simulado.
# Sustituir el proveedor debe tocar solo el adaptador, nunca el dominio (RNF-16).
CORREO_PROVEEDOR_URL=http://localhost:3098
CORREO_URL_BASE_ENLACES=http://localhost:4200/cuenta

# Minutos de bloqueo tras varios intentos fallidos. Se nombra en el correo de
# aviso, por eso lo necesita este servicio aunque el bloqueo lo aplique
# Autenticación.
AUTH_BLOQUEO_MINUTOS=15

# No hay PostgreSQL: el estado de este servicio es la cola.
