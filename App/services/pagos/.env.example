# Copiar a .env antes de levantar el servicio:  cp .env.example .env

NODE_ENV=development
PUERTO=3008
PREFIJO_API=api/v1

# --- PostgreSQL — base propia: solo el libro de idempotencia ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=pagos
POSTGRES_MAX_CONEXIONES=10
POSTGRES_ESPERA_MAXIMA_MS=3000

# --- Redis — comprobar que la sesión no fue revocada (ADR-11) ---
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- Pasarela de pagos (actor externo) ---
# Este es el ÚNICO servicio que la conoce. Antes estaba en dos.
PAGOS_PROVEEDOR_URL=http://localhost:3099
PASARELA_TIMEOUT_MS=10000
# Firma del webhook de la pasarela (HMAC-SHA256). Obligatorio en producción.
PASARELA_SECRETO_WEBHOOK=secreto-webhook-desarrollo

# --- RabbitMQ — aquí se publican PagoAprobado / PagoRechazado (ADR-15) ---
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Autenticación (RNF-06) ---
# Solo la clave pública: verifica tokens y no los firma (ADR-11).
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
