# Infraestructura compartida del equipo — ver App/infra/README.md.
# Levántala primero: docker compose -f App/infra/docker-compose.yml up -d
PORT=3016
DB_HOST=localhost
DB_PORT=5432
DB_USER=hexacore
DB_PASSWORD=hexacore
DB_NAME=eventos_emergencias
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Sesión (RNF-06) — ver App/shared/seguridad/token-sesion.md ---
REDIS_HOST=localhost
REDIS_PUERTO=6380
# Clave PÚBLICA con la que se verifican los tokens que emite el Servicio de
# Administración. Vacía = la de desarrollo (App/infra/claves-desarrollo/).
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
