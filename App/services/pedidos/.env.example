# Copiar a .env (que está en .gitignore) antes de levantar el servicio:
#   cp .env.example .env
#
# Los valores por defecto apuntan a la infraestructura local de
# App/infra/docker-compose.yml.

NODE_ENV=development
PUERTO=3003
PREFIJO_API=api/v1

# --- PostgreSQL (ADR-06) — base propia del microservicio de Pedidos ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=pedidos

# Configuración del pool y tiempo máximo de espera de PostgreSQL.
POSTGRES_MAX_CONEXIONES=10
POSTGRES_ESPERA_MAXIMA_MS=3000

# --- Redis ---
# CU-011: bloqueo temporal de inventario durante el checkout.
# CU-012: caché del catálogo y disponibilidad de productos.
# CU-014: caché del estado de códigos QR para validación rápida.
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- RabbitMQ ---
# CU-011 requiere una cola de mensajes para desacoplar tareas como
# el envío del pedido al establecimiento, la generación del QR
# y el envío de notificaciones.
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Pasarela de pagos ---
# CU-011 requiere integración con una pasarela externa para procesar pagos.
# La URL concreta podrá apuntar a un simulador local durante el desarrollo.
PAGOS_PROVEEDOR_URL=http://localhost:3099

# Tiempo máximo de espera de una respuesta de la pasarela de pagos.
PASARELA_TIMEOUT_MS=10000