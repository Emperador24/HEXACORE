# Copiar a .env (que está en .gitignore) antes de levantar el servicio:
#   cp .env.example .env

NODE_ENV=development
PUERTO=3007
PREFIJO_API=api/v1

# --- PostgreSQL (ADR-06) — base propia de este servicio de dominio ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BD_PEDIDOS=pedidos
POSTGRES_MAX_CONEXIONES=10
POSTGRES_ESPERA_MAXIMA_MS=3000

# --- Redis (ADR-03) — inventario y reservas del CU-011 ---
# 6380, no 6379: el docker-compose lo expone ahí para no chocar con un Redis
# instalado localmente.
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- Broker (ADR-10) — eventos de pedido ---
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Pasarela de pagos (actor externo del CU-011) ---
PAGOS_PROVEEDOR_URL=http://localhost:3099
PASARELA_TIMEOUT_MS=10000

# --- Autenticación (RNF-06) ---
# Clave PÚBLICA con la que se verifican los tokens que emite Autenticación.
# Aquí NO hay clave privada: este servicio verifica y no firma (ADR-11).
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
