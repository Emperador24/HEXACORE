# Copiar a .env antes de levantar:  cp .env.example .env

NODE_ENV=development
PUERTO=3010
PREFIJO_API=api/v1

# --- PostgreSQL — base propia: ingresos y la proyección del evento con el aforo ---
# NO está la tabla de entradas: es de Ventas.
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
POSTGRES_BASE=acceso_qr

# --- Redis — comprobar que la sesión no fue revocada (ADR-11) ---
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- Ventas — el dueño de `Entrada`. Aquí se le pide gastar el QR ---
# El timeout es corto a propósito: hay una persona esperando delante del
# lector, y uno que se queda pensando diez segundos genera cola física.
VENTAS_URL=http://localhost:3001/api/v1
VENTAS_TIMEOUT_MS=4000

# --- Autenticación (RNF-06) ---
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
