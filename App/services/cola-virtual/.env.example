# Copiar a .env antes de levantar el servicio:  cp .env.example .env

NODE_ENV=development
PUERTO=3009
PREFIJO_API=api/v1

# --- Redis — aquí vive la fila. No hay PostgreSQL ---
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- Reglas de la fila ---
# Cuántos compradores pueden estar comprando a la vez, por evento. Es la
# palanca del primer ASR: todo lo que pase de aquí espera. Se calibra con las
# pruebas de carga.
COLA_AFORO_CONCURRENTE=100

# Vida del turno. Debe superar el tiempo de un checkout completo, o alguien se
# quedaría sin turno con el pago en vuelo.
COLA_TURNO_TTL_SEGUNDOS=300

# Cada cuánto se le dice al que espera que vuelva a preguntar.
COLA_REINTENTO_SEGUNDOS=5

# Cuánto dura un sitio en la fila sin volver a preguntar. Debe superar
# COLA_REINTENTO_SEGUNDOS, o se caería de la fila entre consulta y consulta.
COLA_ESPERA_TTL_SEGUNDOS=60

# --- Autenticación (RNF-06) ---
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=
AUTH_JWT_EMISOR=hexacore-administracion
