{
  "name": "hexacore-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace backend: Núcleo, Boletería, Trabajador y Pagos reutilizable",
  "scripts": {
    "build": "nest build nucleo",
    "start": "nest start nucleo",
    "start:dev": "nest start nucleo --watch",
    "start:prod": "node dist/apps/nucleo/main.js",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-unitarias.json",
    "test:cov": "npm test -- --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "test:e2e:infra": "npm run test:infra",
    "test:e2e:limpiar": "npm run test:limpiar",
    "inventario:preparar": "ts-node modulos/alimentos/inventario/preparar-inventario.ts",
    "migracion:identidad:correr": "npm run datos:preparar",
    "migracion:identidad:estado": "typeorm-ts-node-commonjs migration:show -d modulos/identidad/persistencia/data-source.ts",
    "semilla:identidad": "ts-node modulos/identidad/persistencia/semillas/sembrar.ts",
    "test:http:identidad": "bash modulos/identidad/pruebas/correr-todas.sh",
    "migracion:alimentos:correr": "npm run datos:preparar",
    "migracion:alimentos:estado": "typeorm-ts-node-commonjs migration:show -d modulos/alimentos/persistencia/data-source.ts",
    "semilla:alimentos": "ts-node modulos/alimentos/persistencia/semillas/sembrar.ts",
    "test:http:alimentos": "bash modulos/alimentos/pruebas/correr-todas.sh",
    "carga:identidad": "ts-node modulos/identidad/persistencia/semillas/carga.ts",
    "test:imagen:infra": "node test/base-unica/compose.cjs imagenes up -d --build --wait",
    "test:imagen": "node test/comprobar-imagen.cjs",
    "test:cov:e2e": "c8 --all --src=modulos --src=apps --src=compartido --exclude=\"**/*.spec.*\" --exclude=\"**/migraciones/**\" --exclude=\"**/semillas/**\" --reporter=text-summary --reporter=html npm run test:e2e",
    "verificar:infra": "python3 test/comprobar-configuracion.py",
    "migracion:logistica:correr": "npm run datos:preparar",
    "migracion:logistica:estado": "typeorm-ts-node-commonjs migration:show -d modulos/personal-logistica/persistencia/data-source.ts",
    "semilla:logistica": "node modulos/personal-logistica/scripts/seed.mjs",
    "migracion:eventos:estado": "typeorm-ts-node-commonjs migration:show -d modulos/eventos-recintos/persistencia/data-source.ts",
    "semilla:eventos": "ts-node modulos/eventos-recintos/persistencia/semillas/sembrar.ts",
    "carga:logistica": "node modulos/personal-logistica/scripts/carga.mjs",
    "test:boleteria:infra": "npm run test:infra",
    "test:boleteria:limpiar": "npm run test:limpiar",
    "build:boleteria": "nest build boleteria",
    "start:boleteria": "node dist/apps/boleteria/main.js",
    "migracion:ventas:correr": "npm run datos:preparar",
    "migracion:ventas:estado": "typeorm-ts-node-commonjs migration:show -d modulos/entradas/ventas/persistencia/data-source.ts",
    "semilla:ventas": "ts-node modulos/entradas/ventas/persistencia/semillas/sembrar.ts",
    "migracion:catalogo:correr": "npm run datos:preparar",
    "migracion:catalogo:estado": "typeorm-ts-node-commonjs migration:show -d modulos/entradas/catalogo/persistencia/data-source.ts",
    "semilla:catalogo": "ts-node modulos/entradas/catalogo/persistencia/semillas/sembrar.ts",
    "migracion:postventa:correr": "npm run datos:preparar",
    "migracion:postventa:estado": "typeorm-ts-node-commonjs migration:show -d modulos/entradas/postventa/persistencia/data-source.ts",
    "semilla:postventa": "ts-node modulos/entradas/postventa/persistencia/semillas/sembrar.ts",
    "migracion:acceso-qr:correr": "npm run datos:preparar",
    "migracion:acceso-qr:estado": "typeorm-ts-node-commonjs migration:show -d modulos/entradas/acceso-qr/persistencia/data-source.ts",
    "semilla:acceso-qr": "ts-node modulos/entradas/acceso-qr/persistencia/semillas/sembrar.ts",
    "pretest:boleteria": "npm run build:boleteria",
    "test:boleteria": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/boleteria/jest.json --runInBand",
    "test:boleteria:imagen:infra": "npm run test:imagen:infra",
    "test:boleteria:imagen": "node test/boleteria/comprobar-imagen.cjs",
    "contrato:api:boleteria": "ts-node modulos/entradas/ventas/herramientas/exportar-openapi.ts",
    "test:cov:boleteria": "c8 --all --src=modulos/entradas --src=apps/boleteria --exclude=\"**/*.spec.*\" --exclude=\"**/migraciones/**\" --exclude=\"**/semillas/**\" --reporter=text-summary --reporter=html npm run test:boleteria",
    "migracion:pagos:correr": "npm run datos:preparar",
    "migracion:pagos:estado": "typeorm-ts-node-commonjs migration:show -d modulos/finanzas/pagos/persistencia/data-source.ts",
    "test:pagos:unitarias": "npm test -- --runInBand --testPathPatterns=\"finanzas/pagos|autorizacion-pagos|adaptadores-pagos\"",
    "test:pagos:contratos": "node --test --test-concurrency=1 test/pagos/contratos.test.cjs",
    "test:pagos:modulo": "node test/pagos/comprobar-modulo.cjs",
    "pretest:pagos:modulo": "npm run build",
    "test:infra": "node test/base-unica/compose.cjs recursos up -d --build --wait && node test/base-unica/esperar-preparacion.cjs",
    "test:limpiar": "node test/base-unica/compose.cjs imagenes stop",
    "test:pagos:convivencia": "node --test --test-concurrency=1 test/pagos/convivencia.test.cjs",
    "build:trabajador": "nest build trabajador",
    "start:trabajador": "node dist/apps/trabajador/main.js",
    "start:trabajador:dev": "nest start trabajador --watch",
    "pretest:trabajador": "npm run build:trabajador",
    "test:trabajador": "node --test --test-concurrency=1 test/trabajador/contratos.test.cjs",
    "test:trabajador:infra": "docker compose -p hexacore-trabajador-e2e -f test/trabajador/docker-compose.yml up -d --wait",
    "test:trabajador:imagen:infra": "docker compose -p hexacore-trabajador-e2e -f test/trabajador/docker-compose.yml --profile imagen up -d --build --wait",
    "test:trabajador:imagen": "node test/trabajador/comprobar-imagen.cjs",
    "test:trabajador:identidad": "node --test --test-concurrency=1 test/trabajador/identidad.test.cjs",
    "test:trabajador:limpiar": "docker compose -p hexacore-trabajador-e2e -f test/trabajador/docker-compose.yml --profile imagen stop",
    "ensayo:datos:infra": "docker compose -p hexacore-consolidacion-e2e -f test/consolidacion/docker-compose.yml up -d --wait",
    "ensayo:datos": "node test/consolidacion/ensayo.cjs",
    "ensayo:datos:verificar": "node --test --test-concurrency=1 test/consolidacion/verificar.test.cjs",
    "datos:preparar": "node dist/compartido/persistencia/preparar-base.js",
    "datos:clonar-pruebas": "node test/base-unica/clonar-referencia.cjs",
    "datos:lectura-transferida": "node test/base-unica/lectura-transferida.cjs",
    "datos:verificar-preparacion": "node test/base-unica/comprobar-preparacion.cjs",
    "datos:flujos": "node test/base-unica/preparar-flujos.cjs",
    "datos:ejecucion": "node --test --test-concurrency=1 test/base-unica/ejecucion.test.cjs",
    "ensayo:historico": "node test/consolidacion/historico/construir.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "nodemailer": "6.10.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "7.2.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "c8": "^12.0.0",
    "jest": "^30.1.3",
    "supertest": "7.2.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "22.22.3"
  }
}
