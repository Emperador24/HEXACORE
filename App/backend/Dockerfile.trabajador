FROM node:22.22.3-alpine AS compilacion
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY apps ./apps
COPY modulos ./modulos
COPY compartido ./compartido
RUN npm run build:trabajador && npm prune --omit=dev --no-audit --no-fund

FROM node:22.22.3-alpine
WORKDIR /app
ENV NODE_ENV=production PUERTO=3006
COPY --from=compilacion /app/package.json ./
COPY --from=compilacion /app/node_modules ./node_modules
COPY --from=compilacion /app/dist ./dist
USER node
EXPOSE 3006
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PUERTO+'/api/v1/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Solo salud y consumo AMQP. Sin migraciones, SQL, Redis ni JWT.
CMD ["node", "dist/apps/trabajador/main.js"]
