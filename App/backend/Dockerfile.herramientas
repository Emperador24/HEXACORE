# Imagen de herramientas: las semillas de demostración y la preparación del
# inventario de Pedidos, dentro de Docker.
#
# Existe para que arrancar HEXACORE con datos de ejemplo no exija instalar Node
# 22.22.3 ni hacer `npm ci` en el computador: con Docker basta. Las imágenes de
# los servicios no sirven para esto porque quitan las dependencias de
# desarrollo (`npm prune --omit=dev`), y las semillas corren con ts-node.
#
# Los primeros pasos son los mismos que los de `Dockerfile`, así que Docker
# reutiliza su capa de `npm ci` en vez de instalar dos veces.

FROM node:22.22.3-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
RUN apk add --no-cache bash postgresql16-client
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY apps ./apps
COPY modulos ./modulos
COPY compartido ./compartido
COPY herramientas ./herramientas
USER node
CMD ["bash", "herramientas/datos-demo.sh"]
