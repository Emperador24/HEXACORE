# Copiar a .env (que está en .gitignore); elegir PUERTO según el arranque:
#   cp .env.example .env
#
# Configuración para una instalación nueva o después del corte autorizado.
# No convierte las ocho bases existentes. Revisar destino antes de escribir.

NODE_ENV=development
PUERTO=3002
PREFIJO_API=api/v1

# --- PostgreSQL: destino único, ocho esquemas explícitos por módulo ---
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
POSTGRES_BD=hexacore
POSTGRES_USUARIO=hexacore
POSTGRES_CONTRASENA=hexacore
# Conexiones del pool, y cuánto se espera a la base (conexión o consulta) antes
# de responder 503. Sin límite, una base colgada dejaba el login sin responder.
POSTGRES_MAX_CONEXIONES=10
POSTGRES_ESPERA_MAXIMA_MS=3000
# Hilos para scrypt. Vacío = uno por núcleo (Node trae 4 por defecto, que
# limitaba el login a ~76/s). Ver DECISIONES.md §17.
# UV_THREADPOOL_SIZE=

# --- RabbitMQ (ADR-10) — correos de verificación y recuperación ---
# El CU-027 pide "cola de mensajes para el envío asíncrono de correos".
RABBITMQ_URL=amqp://hexacore:hexacore@localhost:5672

# --- Proveedor de Notificaciones (sistema externo del SAD) ---
# En desarrollo apunta al simulador de App/infra/correo-simulado.
CORREO_PROVEEDOR_URL=http://localhost:3098

# Base de los enlaces que viajan en los correos. Apunta al FRONTEND, no a esta
# API: quien abre el enlace debe ver una pantalla, no un JSON.
CORREO_URL_BASE_ENLACES=http://localhost:4200/cuenta

# --- Firma de los tokens de sesión (RS256) ---
# La clave PRIVADA solo la tiene este servicio: quien la tenga puede fabricar un
# token de cualquier usuario, incluido un administrador. Los demás servicios
# reciben solo la PÚBLICA, que sirve para verificar y no para firmar.
#
# Si se dejan vacías, en desarrollo se usan las de App/infra/claves-desarrollo,
# que están en el repositorio. En producción son obligatorias y el servicio se
# niega a arrancar con las de desarrollo.
#   Generarlas: ver App/infra/claves-desarrollo/README.md
AUTH_JWT_CLAVE_PRIVADA_ARCHIVO=
AUTH_JWT_CLAVE_PUBLICA_ARCHIVO=

# --- Redis (ADR-03) — sesiones revocadas ---
# Al cerrar una sesión se anota aquí, para que el resto de microservicios la
# rechacen sin tener que preguntar a este servicio.
REDIS_HOST=localhost
REDIS_PUERTO=6380

# --- Política de cuentas (CU-027) ---
# La ficha exige "tokens con expiración" y "bloqueo ante fuerza bruta" pero no
# fija ningún valor. El razonamiento de cada uno está en DECISIONES.md.

# Longitud mínima de contraseña (paso 2: "valida la fortaleza de la contraseña").
AUTH_LONGITUD_MINIMA_CONTRASENA=10

# Cuánto vive un token de ACCESO, en minutos (1-60). La app lo renueva sola con
# el token de renovación, así que no es cuánto dura la sesión.
AUTH_SESION_MINUTOS=15

# Días que puede pasar una sesión sin usarse antes de caducar (1-365). Cada
# renovación reinicia la cuenta; no hay tope absoluto. Ver DECISIONES.md §21.
AUTH_RENOVACION_DIAS=30

# CU-027D: intentos fallidos consecutivos antes de bloquear, y cuánto dura.
AUTH_INTENTOS_ANTES_DE_BLOQUEAR=5
AUTH_BLOQUEO_MINUTOS=15

# Vida del enlace de verificación de cuenta (paso 5), en horas.
AUTH_VERIFICACION_HORAS=24

# CU-027A: vida del enlace de recuperación de contraseña, en minutos.
AUTH_RECUPERACION_MINUTOS=30

AUTH_JWT_EMISOR=hexacore-administracion

# Personal/Logística usa personal_logistica dentro del mismo POSTGRES_BD.
PREFIJO_COLAS=

# Boletería usa otro proceso (PUERTO=3001 al arrancarlo fuera de Compose).
# Todos los módulos usan POSTGRES_BD, con conexiones y esquemas propios.
TOKEN_SERVICIOS=hexacore-servicios-dev
COLA_AFORO_CONCURRENTE=25

# Pagos local en ambos programas: MISMA base y coordenadas POSTGRES_*.
# Ejecutar datos:preparar una vez antes de arrancar ambos programas.
# Ambos procesos usan finanzas_pagos.transacciones_pago en la misma base.
PAGOS_PROVEEDOR_URL=http://localhost:3099
PASARELA_TIMEOUT_MS=10000
# Solo Núcleo recibe el webhook: obligatorio y secreto en producción.
# Omitir esta variable y la clave privada al configurar Boletería por separado.
PASARELA_SECRETO_WEBHOOK=secreto-webhook-desarrollo
