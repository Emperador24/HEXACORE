    {
      "dot": "amber",
      "title": "Consistencia por eventos",
      "items": [
        "Dos outbox (Ventas y Acceso QR) publican después de confirmar la transacción",
        "Acceso QR consume compra.confirmada y entrada.actualizada; Ventas consume ingreso.registrado",
        "Compartir proceso no vuelve atómicas esas operaciones"
      ]
    },
